<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seema.dev | Operations & IT Professional</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-dark: #0a0f18;
            --bg-card: #111a28;
            --text-main: #94a3b8;
            --text-light: #f8fafc;
            --accent: #2dd4bf; /* Neon Green/Teal */
            --accent-hover: #14b8a6;
            --purple: #a855f7;
            --border: #1e293b;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* NAVBAR */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 50px;
            border-bottom: 1px solid var(--border);
            background-color: rgba(10, 15, 24, 0.9);
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(10px);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-light);
        }

        .logo i {
            color: var(--accent);
            border: 1px solid var(--accent);
            padding: 5px;
            border-radius: 6px;
            font-size: 0.9rem;
        }

        .nav-links {
            display: flex;
            gap: 30px;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--text-main);
            font-size: 0.9rem;
            font-weight: 600;
            transition: color 0.3s;
        }

        .nav-links a:hover, .nav-links a.active {
            color: var(--accent);
        }

        .rtl-btn {
            background-color: transparent;
            border: 1px solid var(--border);
            color: var(--text-light);
            padding: 8px 16px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .rtl-btn i {
            color: #3b82f6;
        }

        /* HERO SECTION */
        .hero {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 80px 50px;
            min-height: 80vh;
        }

        .hero-content {
            max-width: 600px;
        }

        .available-badge {
            background-color: rgba(45, 212, 191, 0.1);
            color: var(--accent);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 20px;
            border: 1px solid rgba(45, 212, 191, 0.2);
        }

        .hero h3 {
            font-size: 1.5rem;
            color: var(--text-light);
            font-weight: 400;
            margin-bottom: 5px;
        }

        .hero h1 {
            font-size: 4rem;
            color: var(--text-light);
            font-weight: 800;
            margin-bottom: 15px;
            line-height: 1.1;
        }

        .hero p {
            font-size: 1.1rem;
            margin-bottom: 30px;
            max-width: 500px;
        }

        .stats {
            display: flex;
            gap: 40px;
            margin-bottom: 40px;
        }

        .stat-item h2 {
            font-size: 2rem;
            color: var(--text-light);
            margin-bottom: 2px;
        }

        .stat-item p {
            font-size: 0.85rem;
            margin-bottom: 0;
        }

        .buttons {
            display: flex;
            gap: 15px;
        }

        .btn {
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s;
        }

        .btn-primary {
            background: linear-gradient(90deg, var(--accent) 0%, var(--purple) 100%);
            color: #fff;
            border: none;
        }

        .btn-primary:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

        .btn-outline {
            background-color: transparent;
            color: var(--text-light);
            border: 1px solid var(--border);
        }

        .btn-outline:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        .hero-image {
            position: relative;
            width: 400px;
            height: 400px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .hero-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 20px;
            z-index: 2;
            border: 2px solid var(--border);
        }

        /* SKILLS SECTION */
        .skills-section {
            padding: 80px 50px;
            text-align: center;
        }

        .section-tag {
            background-color: rgba(45, 212, 191, 0.1);
            color: var(--accent);
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 15px;
        }

        .section-title {
            font-size: 2.5rem;
            color: var(--text-light);
            margin-bottom: 50px;
        }

        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .skill-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 40px 20px;
            transition: transform 0.3s, border-color 0.3s;
        }

        .skill-card:hover {
            transform: translateY(-5px);
            border-color: var(--accent);
        }

        .skill-card i {
            font-size: 2.5rem;
            color: var(--accent);
            margin-bottom: 20px;
        }

        .skill-card h3 {
            color: var(--text-light);
            margin-bottom: 15px;
        }

        .skill-tags {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
        }

        .skill-tags span {
            background-color: rgba(255, 255, 255, 0.05);
            padding: 5px 10px;
            border-radius: 4px;
            font-size: 0.8rem;
            color: var(--text-main);
        }

        /* EXPERIENCE & EDUCATION */
        .resume-section {
            padding: 80px 50px;
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
        }

        .resume-col h2 {
            color: var(--text-light);
            font-size: 1.8rem;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .resume-col h2 i {
            color: var(--accent);
        }

        .timeline {
            border-left: 2px solid var(--border);
            padding-left: 20px;
        }

        .timeline-item {
            position: relative;
            margin-bottom: 30px;
        }

        .timeline-item::before {
            content: "";
            position: absolute;
            left: -27px;
            top: 5px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background-color: var(--accent);
            box-shadow: 0 0 0 4px var(--bg-dark);
        }

        .timeline-date {
            font-size: 0.85rem;
            color: var(--accent);
            font-weight: 600;
            margin-bottom: 5px;
        }

        .timeline-item h3 {
            color: var(--text-light);
            font-size: 1.1rem;
            margin-bottom: 5px;
        }

        .timeline-item p {
            font-size: 0.9rem;
        }

        /* CONTACT SECTION */
        .contact-section {
            padding: 80px 50px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .contact-container {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 30px;
            background-color: var(--bg-card);
            padding: 40px;
            border-radius: 12px;
            border: 1px solid var(--border);
        }

        .contact-info {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .info-item {
            display: flex;
            align-items: center;
            gap: 15px;
            background-color: var(--bg-dark);
            padding: 15px;
            border-radius: 8px;
            border: 1px solid var(--border);
        }

        .info-item i {
            color: var(--accent);
            font-size: 1.2rem;
        }

        .info-item div h4 {
            color: var(--text-light);
            font-size: 0.9rem;
        }

        .info-item div p {
            font-size: 0.8rem;
            color: var(--text-main);
        }

        .contact-form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .contact-form input, .contact-form textarea {
            width: 100%;
            padding: 12px;
            background-color: var(--bg-dark);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-light);
            outline: none;
        }

        .contact-form input:focus, .contact-form textarea:focus {
            border-color: var(--accent);
        }

        /* FOOTER */
        footer {
            text-align: center;
            padding: 30px;
            border-top: 1px solid var(--border);
            font-size: 0.9rem;
        }

        @media (max-width: 900px) {
            .hero, .resume-section, .contact-container {
                grid-template-columns: 1fr;
                flex-direction: column;
                text-align: center;
            }
            .hero-image {
                margin-top: 40px;
                width: 300px;
                height: 300px;
            }
            .nav-links {
                display: none;
            }
            .hero p, .stats {
                margin: 0 auto 30px auto;
                justify-content: center;
            }
            .buttons {
                justify-content: center;
            }
            .hero-content {
                margin: 0 auto;
            }
        }
    </style>
</head>
